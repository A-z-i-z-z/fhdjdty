<?xml version="1.0" encoding="utf-8"?>
<!-- Twin copy of the main shortcuts: only targetPackage differs (without it the twin would open the owner's app). Static launcher shortcuts. Explicit intents: MainActivity is always enabled, whichever launcher icon is active. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_chat"
        android:shortcutShortLabel="@string/srf_sc_new_chat_short"
        android:shortcutLongLabel="@string/srf_sc_new_chat_long">
        <intent
            android:action="dev.pocketagent.app.NEW_CHAT"
            android:targetPackage="dev.pocketagent.app.debug"
            android:targetClass="dev.pocketagent.app.MainActivity"/>
    </shortcut>
    <shortcut
        android:shortcutId="routines"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_routines"
        android:shortcutShortLabel="@string/srf_sc_routines_short"
        android:shortcutLongLabel="@string/srf_sc_routines_long">
        <intent
            android:action="dev.pocketagent.app.ROUTINES"
            android:targetPackage="dev.pocketagent.app.debug"
            android:targetClass="dev.pocketagent.app.MainActivity"/>
    </shortcut>
    <shortcut
        android:shortcutId="terminal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_terminal"
        android:shortcutShortLabel="@string/srf_sc_terminal_short"
        android:shortcutLongLabel="@string/srf_sc_terminal_long">
        <intent
            android:action="dev.pocketagent.app.TERMINAL"
            android:targetPackage="dev.pocketagent.app.debug"
            android:targetClass="dev.pocketagent.app.MainActivity"/>
    </shortcut>
</shortcuts>
