    <!-- Texts that used to be written into the code (feature 0.11). Every key has a note: what it says, where it appears, what each placeholder is, how much room it has. -->

    <!-- Chat engine lines (data, ChatEngine): error and note lines written into a chat -->
    <!-- t: Error line in a chat whose bots were all deleted; no placeholders -->
    <string name="eng_no_bots">This chat has no bots (they were deleted). Add a bot to the chat first.</string>
    <!-- t: Note line when a loop pass starts; %1$d is this pass, %2$d the total; keep the slash; same wording as eng_loop_refine | kind: row -->
    <string name="eng_loop_pass">Loop mode: pass %1$d/%2$d</string>
    <!-- t: Note line from pass 2 on; %1$d is this pass, %2$d the total; same wording as eng_loop_pass | kind: row -->
    <string name="eng_loop_refine">Loop mode: pass %1$d/%2$d — refining…</string>
    <!-- t: Error line after Allow or Deny could not be sent; %1$s is a short technical reason in English -->
    <string name="eng_approval_send_failed">Could not send your answer to Hermes: %1$s</string>
    <!-- t: Line on the permission card when the answer did not reach Hermes; %1$s is a short reason, usually in English; the card can be answered again -->
    <string name="eng_approval_card_error">Your answer did not reach Hermes: %1$s</string>
    <!-- t: Line on the permission card when Hermes no longer waits for the request; Stop is the translated name of the stop button; no placeholders -->
    <string name="eng_approval_gone">Hermes is no longer waiting for this request. Press Stop, then send your message again.</string>
    <!-- t: Error line in a chat; %1$s is the short message Hermes gave, usually in English, never raw data -->
    <string name="eng_err_reason">Hermes reported an error: %1$s</string>
    <!-- t: Error line in a chat when the error carried no message; no placeholders -->
    <string name="eng_err_unknown">Hermes reported an error without saying why. The details are in the app log.</string>
    <!-- t: Error line in a chat; %1$d is the HTTP status number, %2$s the short message Hermes gave, usually in English; keep HTTP -->
    <string name="eng_err_http">Hermes answered with an error (HTTP %1$d): %2$s</string>
    <!-- t: Error line in a chat when the answer had no readable message; %1$d is the HTTP status number; keep HTTP -->
    <string name="eng_err_http_plain">Hermes answered with an error (HTTP %1$d). The details are in the app log.</string>
    <!-- t: Error line for an unexpected failure; %1$s is a technical Class: message text in English -->
    <string name="eng_internal_error">Internal error: %1$s</string>
    <!-- t: Error line when a message is sent while Hermes is stopped; Running is the state shown on Home -->
    <string name="eng_hermes_not_running">Hermes is not running. Start it from the home screen, wait until it says Running, then try again.</string>
    <!-- t: Error line when Hermes failed to start after a message was sent; no placeholders -->
    <string name="eng_hermes_start_failed">Hermes could not start. Open the home screen to see why.</string>
    <!-- t: Error line when the bot of a chat no longer exists; no placeholders -->
    <string name="eng_bot_not_found">Bot not found (it was deleted).</string>
    <!-- t: Error line when the blocking budget is reached; %1$d is the limit; Settings and Usage are the translated names of the Settings tab and the Usage section -->
    <string name="eng_budget_blocked">The daily token budget (%1$d tokens) is reached, so this message was not sent to the model. Raise or turn off the limit under Settings &gt; Usage, or try again tomorrow.</string>
    <!-- t: Note line shown once per chat; %1$s is a model id; keep the quotes around it -->
    <string name="eng_model_foreign">The model \"%1$s\" set for this chat or bot belongs to another provider, so the default model of the current provider is used instead. Change it in the chat controls or the bot editor.</string>
    <!-- t: Reason on an approval card; %1$s is the command or its description, or both on two lines; PROTECTED, a decision text -->
    <string name="eng_approval_pending">Hermes asks permission before it runs this and is waiting for an answer:\n%1$s</string>
    <!-- t: Note line when a reply stopped at the length limit; no placeholders -->
    <string name="eng_cut_off">The answer was cut off (length limit reached).</string>
    <!-- t: Error line; %1$s is a technical reason code and stays as it is; keep finish_reason untranslated -->
    <string name="eng_run_abnormal">The run ended abnormally: finish_reason=%1$s</string>
    <!-- t: Error line with a code; %1$s and %2$s are technical codes; keep finish_reason and error_code untranslated -->
    <string name="eng_run_abnormal_code">The run ended abnormally: finish_reason=%1$s error_code=%2$s</string>
    <!-- t: Warning note, once per day; %1$d is the number of tokens used; Settings and Usage are translated names -->
    <string name="eng_budget_warn">Daily token budget reached: %1$d tokens used today. Hermes keeps answering; change the limit under Settings &gt; Usage.</string>
    <!-- t: Note line when a bot answered with nothing; no placeholders -->
    <string name="eng_empty_reply">The bot returned an empty reply.</string>

    <!-- Terminal lines (hermes, TerminalSession) -->
    <!-- t: Terminal line when a second command is started while one runs; no placeholders -->
    <string name="eng_term_busy">A command is still running. Wait for it or cancel it first.</string>
    <!-- t: Terminal line when the runtime is missing; no placeholders -->
    <string name="eng_term_not_installed">The Hermes runtime is not installed yet. Start Hermes once from the home screen so it can set itself up, then try again.</string>
    <!-- t: Terminal line after a command was cancelled; keep the square brackets | kind: chip -->
    <string name="eng_term_cancelled">[cancelled]</string>
    <!-- t: Terminal line after a command failed; %1$d is the exit code; keep the square brackets | kind: chip -->
    <string name="eng_term_exit_code">[exit code %1$d]</string>
    <!-- t: Terminal line when a command could not start; %1$s is a technical Class: message text in English -->
    <string name="eng_term_run_failed">Could not run the command: %1$s</string>

    <!-- Attachment errors (data, AttachmentStore); they reach the user through a short note -->
    <!-- t: Error when a picked image cannot be read; short phrase, no placeholders | kind: row -->
    <string name="eng_attach_decode">Could not decode image</string>
    <!-- t: Error when a picture cannot be compressed; short phrase; JPEG stays | kind: row -->
    <string name="eng_attach_encode">Could not encode JPEG</string>
    <!-- t: Error when a document is too big; %1$d is the limit in MiB; keep MiB | kind: row -->
    <string name="eng_attach_too_large">File is larger than %1$d MiB</string>
    <!-- t: Error when a picked document cannot be opened; short phrase, no placeholders | kind: row -->
    <string name="eng_attach_open">Could not open selected document</string>

