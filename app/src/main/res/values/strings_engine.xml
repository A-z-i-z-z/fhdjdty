    <!-- Runtime lines (runtime, RuntimeManager); Home shows them as the reason of an error. Arguments that are exceptions, sizes, paths or codes stay technical English -->
    <!-- t: Home error line; %1$s is a technical message in English -->
    <string name="eng_rt_delete_failed">Could not delete the runtime: %1$s</string>
    <!-- t: Home error line for a build made without the Linux image; keep rootfs and CI -->
    <string name="eng_rt_stub_rootfs">This build contains no rootfs (stub build). Install the APK produced by CI.</string>
    <!-- t: Home error line; %1$s is a file name, %2$s a technical Class: message text; Delete runtime files is the translated name of the Settings button btn_reset_runtime -->
    <string name="eng_rt_stamp_unreadable">Cannot read %1$s: %2$s. The runtime was NOT reinstalled, so nothing was deleted. Fix the file\'s permissions, or use Delete runtime files to reinstall from scratch.</string>
    <!-- t: Home error line; the three placeholders are sizes such as 1.2 GiB: needed, free, reclaimable -->
    <string name="eng_rt_no_space">Not enough free storage: need about %1$s, have %2$s free plus %3$s reclaimable from the old runtime</string>
    <!-- t: Home error line; %1$s is a technical Class: message text in English -->
    <string name="eng_rt_extract_failed">Extraction failed: %1$s</string>
    <!-- t: Home error line for a build made without proot; keep the word proot -->
    <string name="eng_rt_stub_proot">Stub build: no proot binary bundled.</string>
    <!-- t: Home error line; %1$s is a file path; keep the word proot -->
    <string name="eng_rt_proot_missing">proot binary missing: %1$s</string>
    <!-- t: Home error line; %1$s is a list of problems in English; Setup is the translated name of the Provider section of Settings -->
    <string name="eng_rt_bad_config">Invalid configuration: %1$s (fix it under Setup)</string>
    <!-- t: Home error line; Stop and Start are the translated names of the two Home buttons -->
    <string name="eng_rt_not_healthy">Hermes did not become healthy within 20 minutes (process still alive; see runtime log). Press Stop, then Start.</string>
    <!-- t: Home error line; %1$d is a network port number; Start is the translated name of the Home button -->
    <string name="eng_rt_foreign_port">Port %1$d is answered by a process that is not our Hermes (another app?). Press Start to retry on a new port.</string>
    <!-- t: Home error line; %1$d is a network port number; keep /health; Start is the translated name of the Home button -->
    <string name="eng_rt_port_unannounced">The API on port %1$d answers /health, but our Hermes never announced that port in its own output within 90 s, so the API key was NOT sent (could be another app on the port, or Hermes logging differently). Press Start to retry.</string>
    <!-- t: Home error line; %1$s is the server answer, up to 200 characters, in English; keep HTTP 401 -->
    <string name="eng_rt_key_rejected">Hermes is up but rejected our API key (HTTP 401): %1$s</string>
    <!-- t: Home error line; %1$s is a technical description of the exit in English -->
    <string name="eng_rt_exited">Hermes exited unexpectedly: %1$s</string>
    <!-- t: Home error line when a hint exists; %1$s is the technical exit description, %2$s a short hint, both in English -->
    <string name="eng_rt_exited_hint">Hermes exited unexpectedly: %1$s - %2$s</string>
    <!-- t: Terminal line for a build made without the Linux image; keep proot and rootfs -->
    <string name="eng_rt_term_stub">This build contains no proot or rootfs (stub build).</string>
    <!-- t: Terminal line when the runtime is missing; no placeholders -->
    <string name="eng_rt_term_not_installed">The Hermes runtime is not installed yet.</string>
    <!-- t: Terminal line when the shell cannot start; %1$s is a technical Class: message text in English -->
    <string name="eng_rt_term_shell_failed">Could not start the shell: %1$s</string>
    <!-- t: Voice error line; %1$d is an error code; TTS means text to speech and stays | kind: row -->
    <string name="eng_tts_error">System TTS error (%1$d)</string>
    <!-- t: Voice error line; TTS means text to speech and stays | kind: row -->
    <string name="eng_tts_unavailable">System TTS unavailable</string>
    <!-- t: Voice error line; %1$d is a status code; TTS means text to speech and stays | kind: row -->
    <string name="eng_tts_init_failed">System TTS init failed (%1$d)</string>

