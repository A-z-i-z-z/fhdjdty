    <!-- Templates -->
    <string name="rtn_tpl_morning_name">Point du matin</string>
    <string name="rtn_tpl_morning_desc">Un début de journée chaleureux avec quelques idées utiles.</string>
    <string name="rtn_tpl_morning_prompt">Bonjour ! Fais-moi un court point pour aujourd\'hui : un salut chaleureux, ce qui mérite d\'être retenu de nos échanges précédents, et trois suggestions utiles pour bien commencer la journée. Moins de 150 mots.</string>
    <string name="rtn_tpl_journal_name">Journal du soir</string>
    <string name="rtn_tpl_journal_desc">Une question qui invite à réfléchir sur la journée.</string>
    <string name="rtn_tpl_journal_prompt">Pose-moi une seule question qui m\'aide à réfléchir à ma journée. Pose seulement la question, rien d\'autre.</string>
    <string name="rtn_tpl_weekly_name">Bilan de la semaine</string>
    <string name="rtn_tpl_weekly_desc">Chaque dimanche soir : regarder en arrière et préparer la semaine.</string>
    <string name="rtn_tpl_weekly_prompt">C\'est l\'heure de mon bilan hebdomadaire. Pose-moi trois questions courtes sous forme de liste numérotée : ce qui s\'est bien passé cette semaine, ce qui a été difficile et sur quoi je veux me concentrer la semaine prochaine.</string>
    <string name="rtn_tpl_kurdish_name">Mot kurde du jour</string>
    <string name="rtn_tpl_kurdish_desc">Apprends un mot kurde (kurmandji) chaque matin.</string>
    <string name="rtn_tpl_kurdish_prompt">Apprends-moi aujourd\'hui un mot kurde (kurmandji) : le mot, sa prononciation, son sens et une phrase d\'exemple avec sa traduction. Choisis un mot que nous n\'avons pas encore utilisé dans cette conversation.</string>

