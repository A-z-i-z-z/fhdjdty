{"id": "o_two_pow_three_pow", "name": "o_two_pow_three_pow", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(m n : ℕ) (h : 2 ^ m + 1 = 3 ^ n) : (m = 1 ∧ n = 1) ∨ (m = 3 ∧ n = 2)", "notes": "Catalan-type equation, small case.", "expected_in_mathlib": false}
{"id": "o_floor_sqrt", "name": "o_floor_sqrt", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(n : ℕ) : ⌊Real.sqrt n + Real.sqrt (n + 1)⌋ = ⌊Real.sqrt (4 * n + 2)⌋", "notes": "Classic floor identity; hard.", "expected_in_mathlib": false}
{"id": "o_hermite2", "name": "o_hermite2", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(x : ℝ) : ⌊x⌋ + ⌊x + 1 / 2⌋ = ⌊2 * x⌋", "notes": "Hermite's identity, n = 2.", "expected_in_mathlib": false}
{"id": "o_rec_linear", "name": "o_rec_linear", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a : ℕ → ℝ) (h0 : a 0 = 1) (h : ∀ n, a (n + 1) = 2 * a n + 1) : ∀ n, a n = 2 ^ (n + 1) - 1", "notes": "Solve a recurrence.", "expected_in_mathlib": false}
{"id": "o_rec_second", "name": "o_rec_second", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a : ℕ → ℤ) (h0 : a 0 = 0) (h1 : a 1 = 1) (h : ∀ n, a (n + 2) = 3 * a (n + 1) - 2 * a n) : ∀ n, a n = 2 ^ n - 1", "notes": "Second-order recurrence; strong induction.", "expected_in_mathlib": false}
{"id": "o_poly_coeffs", "name": "o_poly_coeffs", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a b : ℝ) (h : ∀ x : ℝ, x ^ 2 + a * x + b = (x - 1) * (x - 2)) : a = -3 ∧ b = 2", "notes": "Compare values at chosen points.", "expected_in_mathlib": false}
{"id": "o_vieta_cubes", "name": "o_vieta_cubes", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(x y : ℝ) (h1 : x + y = 5) (h2 : x * y = 6) : x ^ 3 + y ^ 3 = 35", "notes": "Symmetric functions.", "expected_in_mathlib": false}
{"id": "o_complex_sqrt_neg1", "name": "o_complex_sqrt_neg1", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(z : ℂ) (h : z ^ 2 = -1) : z = Complex.I ∨ z = -Complex.I", "notes": "Roots of z² + 1.", "expected_in_mathlib": false}
{"id": "o_complex_norm", "name": "o_complex_norm", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": ": ‖(1 + Complex.I) ^ 10‖ = 32", "notes": "|1+i| = √2.", "expected_in_mathlib": false}
{"id": "o_trig_quartic", "name": "o_trig_quartic", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(x : ℝ) : Real.sin x ^ 4 + Real.cos x ^ 4 = 1 - 2 * Real.sin x ^ 2 * Real.cos x ^ 2", "notes": "Pythagorean identity squared.", "expected_in_mathlib": false}
{"id": "o_cos36_cos72", "name": "o_cos36_cos72", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": ": Real.cos (Real.pi / 5) - Real.cos (2 * Real.pi / 5) = 1 / 2", "notes": "Golden-ratio trig; hard.", "expected_in_mathlib": false}
{"id": "o_titu", "name": "o_titu", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) : a + b + c ≤ a ^ 2 / b + b ^ 2 / c + c ^ 2 / a", "notes": "Titu / Engel form.", "expected_in_mathlib": false}
{"id": "o_sq_sum_third", "name": "o_sq_sum_third", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a b c : ℝ) (h : a + b + c = 1) : 1 / 3 ≤ a ^ 2 + b ^ 2 + c ^ 2", "notes": "QM-AM.", "expected_in_mathlib": false}
{"id": "o_recip_sum3", "name": "o_recip_sum3", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (h : a + b + c = 3) : 3 ≤ 1 / a + 1 / b + 1 / c", "notes": "HM-AM, three terms.", "expected_in_mathlib": false}
{"id": "o_imo1995_p2", "name": "o_imo1995_p2", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (h : a * b * c = 1) : 3 / 2 ≤ 1 / (a ^ 3 * (b + c)) + 1 / (b ^ 3 * (c + a)) + 1 / (c ^ 3 * (a + b))", "notes": "IMO 1995 P2; very hard.", "expected_in_mathlib": false}
{"id": "o_n_dvd_2n_sub1", "name": "o_n_dvd_2n_sub1", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(n : ℕ) (h : 0 < n) (hd : n ∣ 2 ^ n - 1) : n = 1", "notes": "Smallest prime factor and order argument; hard.", "expected_in_mathlib": false}
{"id": "o_prime_sq_add2", "name": "o_prime_sq_add2", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(p : ℕ) (hp : p.Prime) (h : (p ^ 2 + 2).Prime) : p = 3", "notes": "Mod 3 argument.", "expected_in_mathlib": false}
{"id": "o_prime_triplet", "name": "o_prime_triplet", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(p : ℕ) (hp : p.Prime) (h1 : (p + 2).Prime) (h2 : (p + 4).Prime) : p = 3", "notes": "One of p, p+2, p+4 is divisible by 3.", "expected_in_mathlib": false}
{"id": "o_count_3_or_5", "name": "o_count_3_or_5", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": ": ((range 1001).filter (fun n => 3 ∣ n ∨ 5 ∣ n)).card = 468", "notes": "Inclusion-exclusion (computation).", "expected_in_mathlib": false}
{"id": "o_vandermonde_sq", "name": "o_vandermonde_sq", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(n : ℕ) : ∑ k ∈ range (n + 1), (n.choose k) ^ 2 = (2 * n).choose n", "notes": "Vandermonde special case.", "expected_in_mathlib": true}
{"id": "o_sum_k_choose", "name": "o_sum_k_choose", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(n : ℕ) : ∑ k ∈ range (n + 1), k * n.choose k = n * 2 ^ (n - 1)", "notes": "Absorption identity.", "expected_in_mathlib": false}
{"id": "o_primes_3mod4", "name": "o_primes_3mod4", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": ": ∀ N : ℕ, ∃ p, N < p ∧ p.Prime ∧ p % 4 = 3", "notes": "Infinitely many primes ≡ 3 mod 4.", "expected_in_mathlib": false}
{"id": "o_ab_bc_ca_le", "name": "o_ab_bc_ca_le", "requires": "mathlib", "tier": "olympiad", "preamble": "", "statement": "(a b c : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (h : a + b + c = 1) : a * b + b * c + c * a - 2 * a * b * c ≤ 7 / 27", "notes": "IMO 1984 P1 (upper half).", "expected_in_mathlib": false}
