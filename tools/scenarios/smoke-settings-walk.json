{
  "name": "smoke-settings-walk",
  "title": "Each of the ten settings sections opens without a crash and has spoken labels",
  "flags": ["core", "smoke"],
  "safe": true,
  "timeoutSec": 240,
  "steps": [
    {"op": "link", "debug": {"route": "settings:provider"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:provider", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:usage"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:usage", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:behaviour"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:behaviour", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:appearance"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:appearance", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:voice"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:voice", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:language"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:language", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:backup"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:backup", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:runtime"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:runtime", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:diagnostics"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:diagnostics", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "link", "debug": {"route": "settings:about"}},
    {"op": "wait", "any": [{"tag": "screen.settings"}], "navTop": "settings:about", "timeout": 10},
    {"op": "wait", "ms": 300},
    {"op": "a11y"},
    {"op": "noCrash"}
  ]
}
