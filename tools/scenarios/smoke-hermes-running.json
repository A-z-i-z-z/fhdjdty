{
  "name": "smoke-hermes-running",
  "title": "Hermes starts by itself and reaches Running",
  "flags": ["core", "smoke"],
  "safe": true,
  "timeoutSec": 260,
  "steps": [
    {"op": "link", "debug": {"route": "home"}},
    {"op": "tap", "any": [{"tag": "tab.settings"}, {"desc": "Settings"}]},
    {"op": "tap", "any": [{"tag": "settings.section.runtime"}, {"text": "Runtime"}]},
    {"op": "wait", "state": "Running", "timeout": 180},
    {"op": "expect", "tag": "settings.runtime.state"},
    {"op": "a11y"},
    {"op": "noCrash"}
  ]
}
