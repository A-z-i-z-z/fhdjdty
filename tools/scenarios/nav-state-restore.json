{
  "name": "nav-state-restore",
  "title": "Scroll places, an empty new editor and the screen stack survive back, tab switches and a killed process",
  "flags": ["core"],
  "timeoutSec": 300,
  "steps": [
    {"op": "link", "debug": {"reset": "1"}},
    {"op": "seed", "spec": "chats:40"},
    {"op": "link", "debug": {"reset": "1", "route": "chats"}},
    {"op": "wait", "tag": "chats.new", "timeout": 10},
    {"op": "swipe", "dir": "up", "ms": 300, "times": 3},
    {"op": "wait", "any": [{"tag": "chats.row.12"}, {"tag": "chats.row.13"}, {"tag": "chats.row.14"}, {"tag": "chats.row.15"}], "timeout": 8},
    {"op": "shot", "name": "a-list-scrolled"},
    {"op": "tap", "any": [{"tag": "chats.row.12"}, {"tag": "chats.row.13"}, {"tag": "chats.row.14"}, {"tag": "chats.row.15"}]},
    {"op": "wait", "any": [{"tag": "screen.chat"}], "navTop": "chat", "timeout": 10},
    {"op": "key", "key": "BACK"},
    {"op": "wait", "tag": "chats.new", "timeout": 10},
    {"op": "expect", "any": [{"tag": "chats.row.12"}, {"tag": "chats.row.13"}, {"tag": "chats.row.14"}, {"tag": "chats.row.15"}], "timeout": 8},
    {"op": "expectNot", "tag": "chats.row.0", "timeout": 2},
    {"op": "shot", "name": "a-list-after-back"},
    {"op": "tap", "any": [{"tag": "tab.bots"}, {"desc": "Bots"}]},
    {"op": "wait", "any": [{"tag": "screen.bots"}], "navTop": "bots", "timeout": 10},
    {"op": "swipe", "dir": "up", "ms": 300, "times": 2},
    {"op": "shot", "name": "b-bots-scrolled"},
    {"op": "tap", "any": [{"tag": "tab.chats"}, {"desc": "Chats"}]},
    {"op": "tap", "any": [{"tag": "tab.bots"}, {"desc": "Bots"}]},
    {"op": "wait", "ms": 600},
    {"op": "shot", "name": "b-bots-after-tabs"},
    {"op": "link", "debug": {"route": "routinenew"}},
    {"op": "wait", "any": [{"tag": "screen.routineeditor"}], "navTop": "routinenew", "timeout": 10},
    {"op": "tap", "any": [{"textContains": "Name"}, {"descContains": "Name"}]},
    {"op": "type", "text": "NavProbe"},
    {"op": "expect", "textContains": "NavProbe", "timeout": 5},
    {"op": "key", "key": "BACK"},
    {"op": "key", "key": "BACK"},
    {"op": "tap", "tag": "dialog.confirm", "timeout": 5},
    {"op": "link", "debug": {"route": "routinenew"}},
    {"op": "wait", "any": [{"tag": "screen.routineeditor"}], "navTop": "routinenew", "timeout": 10},
    {"op": "expectNot", "textContains": "NavProbe", "timeout": 3},
    {"op": "link", "debug": {"reset": "1", "route": "chats"}},
    {"op": "wait", "tag": "chats.new", "timeout": 10},
    {"op": "swipe", "dir": "up", "ms": 300, "times": 2},
    {"op": "kill"},
    {"op": "link", "intent": {"action": "android.intent.action.MAIN"}},
    {"op": "wait", "any": [{"tag": "screen.chats"}], "navTop": "chats", "timeout": 20},
    {"op": "expectNot", "tag": "chats.row.0", "timeout": 2},
    {"op": "shot", "name": "g-after-kill"},
    {"op": "noCrash"}
  ]
}
